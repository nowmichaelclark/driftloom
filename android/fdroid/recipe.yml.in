# F-Droid's build recipe for the app: what fdroiddata's metadata/<id>.yml holds
# (queue item 107e, session 29). Not the file itself: render.mjs fills the
# @...@ values from android/gradle.properties and the git checkout, so the id,
# the name and the version are each written once, in gradle.properties, and
# session 31a (the new name) changes nothing here. docs/notes/for-mikey.md says
# how it is submitted; android/README.md ("F-Droid") says how it is tested.
Categories:
  - Ambient Sound
  - Meditation
License: MIT
SourceCode: @REPO_URL@
IssueTracker: @REPO_URL@/issues
Changelog: @REPO_URL@/releases

AutoName: @APP_NAME@

RepoType: git
Repo: @REPO_GIT@
@BINARIES@
Builds:
  - versionName: @VERSION_NAME@
    versionCode: @VERSION_CODE@
    commit: @COMMIT@
    subdir: android
    sudo:
      - apt-get update
      - apt-get install -y gcc
    gradle:
      - yes
    output: app/build/outputs/apk/release/*-universal-release-unsigned.apk
    # (sudo: Rust's build scripts, the core's build.rs, link with the host's cc.)
    # F-Droid builds everything from source and refuses what is prebuilt in the
    # tree: the committed js/dlplayer.wasm is deleted before its scan and built
    # again from core/ by tools/build-core.sh (which proves the committed file
    # is its source on every PR: the same bytes); the research archives and a
    # package.json without a lock file, which the app does not use, are deleted
    # too. The native core (android/native, built by Gradle's buildNative task
    # with the NDK below) is Rust as well: rustup's own script, from its source
    # at a pinned release (the srclib), installs the compiler the repository
    # pins (core/rust-toolchain.toml and android/native/rust-toolchain.toml say
    # the same) with the targets of the web's module and Android's three. No
    # crate is downloaded: Cargo.lock lists this repository's own crates only.
    srclibs:
      - rustup@1.28.2
    scandelete:
      - docs/ears/raw
      - design/test-kit/package.json
      - js/dlplayer.wasm
    build:
      - toolchain=$(sed -n 's/^channel = "\(.*\)"/\1/p' native/rust-toolchain.toml)
      - $$rustup$$/rustup-init.sh -y --default-toolchain $toolchain --profile minimal
        --target wasm32-unknown-unknown,aarch64-linux-android,armv7-linux-androideabi,x86_64-linux-android
      - source $HOME/.cargo/env
      - cd ..
      - tools/build-core.sh
    # The same NDK as android/gradle.properties (driftloom.ndkVersion).
    ndk: r28c

@ALLOWED@
AutoUpdateMode: Version
UpdateCheckMode: Tags ^v[0-9][0-9.]*$
UpdateCheckData: android/gradle.properties|driftloom\.versionCode=(\d+)|android/gradle.properties|driftloom\.versionName=(.+)
CurrentVersion: @VERSION_NAME@
CurrentVersionCode: @VERSION_CODE@
