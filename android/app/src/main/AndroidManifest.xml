<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only what playing with the screen off and saving a file need (session
         28), and no network: the app's files are inside it, and the page never
         reaches the network (MainActivity blocks it).
         - the foreground service, of the media playback kind (the music
           playing with the screen off), and of the data sync kind (a file
           being made and saved while the music is paused);
         - the notification, which Android 13 and later asks the listener
           about (asked once, at the first Play, with the app still working
           if refused);
         - the wake lock, held only while the music plays or a file is saved. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.App"
        android:usesCleartextTraffic="false">

        <!-- No Google services, not even the WebView's: its Safe Browsing
             lookups and its usage metrics are off. -->
        <meta-data
            android:name="android.webkit.WebView.EnableSafeBrowsing"
            android:value="false" />
        <meta-data
            android:name="android.webkit.WebView.MetricsOptOut"
            android:value="true" />

        <!-- Turning the screen or the window must not rebuild the page: the
             loop playing in it would stop. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|layoutDirection|fontScale"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The music's foreground service (PlaybackService): the notification,
             the lock screen's controls, the audio focus and the wake lock,
             held only while something plays or is saved. -->
        <service
            android:name=".PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback|dataSync" />
    </application>
</manifest>
